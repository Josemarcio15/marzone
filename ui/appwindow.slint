export struct MonitorTabItem {
    id: int,          // 1, 2, 3...
    name: string,     // "Monitor 1 (3072×1728)"
    is_primary: bool,
}

export struct ZoneData {
    id: int,
    key: string,
    title: string,
    x: float,
    y: float,
    w: float,
    h: float,
    monitor: int, // 0 = Atual/Auto, 1 = Monitor 1, 2 = Monitor 2...
    color: color,
}

export struct LayoutItem {
    id: string,
    name: string,
    is_active: bool,
}

component LayoutCard inherits Rectangle {
    in property <string> name;
    in property <string> layout_id;
    in property <bool> is_active: false;
    callback clicked();
    callback delete_clicked();

    height: 38px;
    background: is_active ? #1f6feb.transparentize(0.7) : (touch.has-hover ? #21262d : #161b22);
    border-color: is_active ? #58a6ff : (touch.has-hover ? #484f58 : #30363d);
    border-width: is_active ? 2px : 1px;
    border-radius: 8px;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        alignment: center;

        // Ícone ou indicador ativo
        if is_active : Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: #58a6ff;
            y: (parent.height - 8px) / 2;
        }

        Text {
            text: root.name;
            color: is_active ? #ffffff : #c9d1d9;
            font-size: 13px;
            font-weight: is_active ? 700 : 500;
            vertical-alignment: center;
        }

        // Botão de deletar (X) se não for o único ou se hover
        del_touch := TouchArea {
            width: 22px;
            height: 22px;
            clicked => { root.delete_clicked(); }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: del_touch.has-hover ? #da3633.transparentize(0.3) : transparent;

                Text {
                    text: "×";
                    color: del_touch.has-hover ? #ffffff : #8b949e;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component ZoneBox inherits Rectangle {
    in property <ZoneData> data;
    in property <bool> is-selected: false;
    in property <length> canvas-width;
    in property <length> canvas-height;

    callback selected();
    callback moved(length, length);
    callback resized(length, length);

    x: data.x * canvas-width;
    y: data.y * canvas-height;
    width: data.w * canvas-width;
    height: data.h * canvas-height;

    background: data.color.transparentize(is-selected ? 0.35 : 0.65);
    border-color: is-selected ? #ffffff : data.color;
    border-width: is-selected ? 3px : 2px;
    border-radius: 8px;

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.selected();
            }
        }
        moved => {
            root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        alignment: start;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: data.color;
                y: 4px;
            }

            Text {
                text: "Super + " + data.key;
                color: #ffffff;
                font-size: 15px;
                font-weight: 800;
            }
        }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: data.monitor > 0 ? "🖥️ Monitor " + data.monitor : "🖥️ Monitor Atual";
                    color: #ffd700;
                    font-size: 11px;
                    font-weight: 700;
                }

                Text {
                    text: "• " + Math.round(data.w * 100) + "% × " + Math.round(data.h * 100) + "%";
                    color: #f0f0f0;
                    font-size: 11px;
                    font-weight: 600;
                }
            }
    }

    // Resize Handle (Canto inferior direito com a cor da zona destacada)
    if is-selected : Rectangle {
        x: parent.width - 18px;
        y: parent.height - 18px;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        background: #ffd700;
        border-width: 1px;
        border-color: #00000088;

        TouchArea {
            moved => {
                root.resized(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
}

component KeyBadge inherits Rectangle {
    in property <string> key-char;
    in property <bool> is-active: false;
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: 6px;
    background: is-active ? #388bfd : #21262d;
    border-width: is-active ? 2px : 1px;
    border-color: is-active ? #ffffff : #30363d;

    TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.key-char;
        color: is-active ? #ffffff : #c9d1d9;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <color> base-color;
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    min-width: 140px;
    border-radius: 6px;
    background: !enabled ? #30363d : (touch.pressed ? base-color.darker(0.2) : (touch.has-hover ? base-color.brighter(0.15) : base-color));
    border-width: 1px;
    border-color: !enabled ? #484f58 : base-color.brighter(0.3);

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            color: !root.enabled ? #8b949e : #ffffff;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "Marzone — Editor Visual de Layouts";
    preferred-width: 1040px;
    preferred-height: 740px;
    background: #0d1117;

    in-out property <[MonitorTabItem]> monitors-list: [];
    in-out property <int> active-monitor-tab: 1; // ID do monitor selecionado (1, 2...)
    callback select-monitor-tab(int);

    in-out property <[LayoutItem]> layouts-list: [];
    in-out property <[ZoneData]> zones: [];
    in-out property <int> selected-id: -1;
    in-out property <string> layout-name: "Foco + Terminais";
    in-out property <string> selected-key: "1";
    in-out property <int> selected-monitor: 0; // 0 = Atual, 1 = Monitor 1, 2 = Monitor 2...

    in-out property <[string]> row1-keys: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];
    in-out property <[string]> row2-keys: ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"];
    in-out property <[string]> row3-keys: ["A", "S", "D", "F", "G", "H", "J", "K", "L"];
    in-out property <[string]> row4-keys: ["Z", "X", "C", "V", "B", "N", "M"];

    in-out property <bool> is-renaming: false;
    in-out property <string> edit-name-text: "";

    in-out property <int> gap-val: 6;
    callback gap-changed(int);
    callback select-layout(string);
    callback new-layout();
    callback delete-layout(string);
    callback rename-layout(string);
    callback save-and-apply();
    callback add-zone();
    callback remove-zone();
    callback zone-moved(int, length, length, length, length);
    callback zone-resized(int, length, length, length, length);
    callback select-key(string);
    callback select-monitor(int);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Barra de Abas dos Monitores Conectados
        Rectangle {
            background: #161b22;
            border-color: #30363d;
            border-width: 1px;
            border-radius: 8px;
            height: 48px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;

                Text {
                    text: "Monitores Detectados:";
                    color: #8b949e;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                for mon in root.monitors-list: Rectangle {
                    height: 32px;
                    min-width: 140px;
                    border-radius: 6px;
                    background: mon.id == root.active-monitor-tab ? #1f6feb : (mon_touch.has-hover ? #21262d : #0d1117);
                    border-width: 1px;
                    border-color: mon.id == root.active-monitor-tab ? #58a6ff : (mon_touch.has-hover ? #484f58 : #30363d);
                    y: (parent.height - self.height) / 2;

                    mon_touch := TouchArea {
                        clicked => {
                            root.select-monitor-tab(mon.id);
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        Text {
                            text: "🖥️ " + mon.name + (mon.is_primary ? " (Principal)" : "");
                            color: mon.id == root.active-monitor-tab ? #ffffff : #c9d1d9;
                            font-size: 12px;
                            font-weight: mon.id == root.active-monitor-tab ? 700 : 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Card com lista horizontal de Layouts + Botão + Novo Layout
        Rectangle {
            background: #161b22;
            border-color: #30363d;
            border-width: 1px;
            border-radius: 8px;
            height: 56px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;

                Text {
                    text: "Layouts:";
                    color: #8b949e;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                // Lista Horizontal de Layouts
                for item in root.layouts-list: LayoutCard {
                    name: item.name;
                    layout_id: item.id;
                    is_active: item.is_active;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.select-layout(item.id);
                    }
                    delete_clicked => {
                        root.delete-layout(item.id);
                    }
                }

                // Botão + Novo Layout
                new_btn := Rectangle {
                    height: 38px;
                    min-width: 120px;
                    border-radius: 8px;
                    background: new_touch.has-hover ? #238636 : #21262d;
                    border-color: new_touch.has-hover ? #2ea043 : #30363d;
                    border-width: 1px;
                    y: (parent.height - self.height) / 2;

                    new_touch := TouchArea {
                        clicked => { root.new-layout(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "+ Novo Layout";
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Top Header Info
        HorizontalLayout {
            spacing: 12px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Layout Ativo:";
                    color: #8b949e;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                if !root.is-renaming : Text {
                    text: root.layout-name;
                    color: #58a6ff;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                if !root.is-renaming : rename_btn := Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: rename_touch.has-hover ? #21262d : #161b22;
                    border-color: rename_touch.has-hover ? #58a6ff : #30363d;
                    border-width: 1px;
                    y: (parent.height - self.height) / 2;

                    rename_touch := TouchArea {
                        clicked => {
                            root.edit-name-text = root.layout-name;
                            root.is-renaming = true;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: center;

                        Text {
                            text: "✎";
                            color: rename_touch.has-hover ? #58a6ff : #c9d1d9;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Renomear";
                            color: rename_touch.has-hover ? #58a6ff : #8b949e;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.is-renaming : Rectangle {
                    width: 180px;
                    height: 28px;
                    background: #0d1117;
                    border-color: #58a6ff;
                    border-width: 1px;
                    border-radius: 4px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        TextInput {
                            text <=> root.edit-name-text;
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            accepted => {
                                root.rename-layout(root.edit-name-text);
                                root.is-renaming = false;
                            }
                        }
                    }
                }

                if root.is-renaming : ok_rename_btn := Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 4px;
                    background: ok_rename_touch.has-hover ? #238636 : #2ea043.transparentize(0.4);
                    y: (parent.height - self.height) / 2;

                    ok_rename_touch := TouchArea {
                        clicked => {
                            root.rename-layout(root.edit-name-text);
                            root.is-renaming = false;
                        }
                    }

                    Text {
                        text: "✓";
                        color: #ffffff;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.is-renaming : cancel_rename_btn := Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 4px;
                    background: cancel_rename_touch.has-hover ? #da3633 : #30363d;
                    y: (parent.height - self.height) / 2;

                    cancel_rename_touch := TouchArea {
                        clicked => {
                            root.is-renaming = false;
                        }
                    }

                    Text {
                        text: "×";
                        color: #ffffff;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: "Arraste para mover | Alça inferior redimensiona (Snap 5%)";
                color: #8b949e;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // Canvas Central
        canvas := Rectangle {
            background: #161b22;
            border-color: #30363d;
            border-width: 1px;
            border-radius: 8px;
            clip: true;

            for zone in root.zones: ZoneBox {
                data: zone;
                is-selected: zone.id == root.selected-id;
                canvas-width: canvas.width;
                canvas-height: canvas.height;

                selected => {
                    root.selected-id = zone.id;
                    root.selected-key = zone.key;
                    root.selected-monitor = zone.monitor;
                }
                moved(dx, dy) => {
                    root.zone-moved(zone.id, dx, dy, canvas.width, canvas.height);
                }
                resized(dx, dy) => {
                    root.zone-resized(zone.id, dx, dy, canvas.width, canvas.height);
                }
            }
        }

        // Seletor de Teclas de Atalho com Teclado Organizado em 4 Linhas
        Rectangle {
            background: #161b22;
            border-color: #30363d;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                alignment: center;

                // Linha de Configuração do Monitor Alvo da Zona (apenas informativo)
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "Esta zona pertence a:";
                        color: #8b949e;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 28px;
                        min-width: 120px;
                        border-radius: 6px;
                        background: #1f6feb.transparentize(0.8);
                        border-width: 1px;
                        border-color: #58a6ff;
                        HorizontalLayout {
                            alignment: center;
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "🖥️ Monitor " + root.active-monitor-tab;
                                color: #58a6ff;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: root.selected-id != -1 ? ("Atribuir tecla à zona ativa (Super + " + root.selected-key + "):") : "Selecione uma zona para atribuir tecla:";
                    color: #f0f6fc;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                // Linha 1: 1 - 0
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    for k in root.row1-keys: KeyBadge {
                        key-char: k;
                        is-active: root.selected-id != -1 && root.selected-key == k;
                        clicked => {
                            if (root.selected-id != -1) {
                                root.selected-key = k;
                                root.select-key(k);
                            }
                        }
                    }
                }

                // Linha 2: Q - P
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    for k in root.row2-keys: KeyBadge {
                        key-char: k;
                        is-active: root.selected-id != -1 && root.selected-key == k;
                        clicked => {
                            if (root.selected-id != -1) {
                                root.selected-key = k;
                                root.select-key(k);
                            }
                        }
                    }
                }

                // Linha 3: A - L
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    for k in root.row3-keys: KeyBadge {
                        key-char: k;
                        is-active: root.selected-id != -1 && root.selected-key == k;
                        clicked => {
                            if (root.selected-id != -1) {
                                root.selected-key = k;
                                root.select-key(k);
                            }
                        }
                    }
                }

                // Linha 4: Z - M
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    for k in root.row4-keys: KeyBadge {
                        key-char: k;
                        is-active: root.selected-id != -1 && root.selected-key == k;
                        clicked => {
                            if (root.selected-id != -1) {
                                root.selected-key = k;
                                root.select-key(k);
                            }
                        }
                    }
                }
            }
        }

        // Barra Inferior de Ações (Adicionar, Remover, Controle de Gap, Salvar)
        HorizontalLayout {
            spacing: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;

                ActionButton {
                    text: "+ Adicionar Zona";
                    base-color: #238636; // Verde
                    clicked => { root.add-zone(); }
                }

                ActionButton {
                    text: "- Remover Zona";
                    base-color: #da3633; // Vermelho
                    enabled: root.selected-id != -1;
                    clicked => { root.remove-zone(); }
                }

                // Controle de Espaçamento / Padding / Gap
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: #161b22;
                    border-width: 1px;
                    border-color: #30363d;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: "Gap / Padding:";
                            color: #8b949e;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        // Botão Diminuir (-)
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            background: gap_minus.has-hover ? #30363d : #21262d;
                            border-width: 1px;
                            border-color: #30363d;
                            gap_minus := TouchArea {
                                clicked => {
                                    if (root.gap-val > 0) {
                                        root.gap-val = root.gap-val - 1;
                                        root.gap-changed(root.gap-val);
                                    }
                                }
                            }
                            Text {
                                text: "-";
                                color: #c9d1d9;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        // Valor Atual em px
                        Rectangle {
                            min-width: 48px;
                            height: 28px;
                            border-radius: 4px;
                            background: root.gap-val == 0 ? #1f6feb.transparentize(0.7) : #0d1117;
                            border-width: 1px;
                            border-color: root.gap-val == 0 ? #58a6ff : #30363d;
                            Text {
                                text: "\{root.gap-val}px";
                                color: root.gap-val == 0 ? #58a6ff : #ffffff;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        // Botão Aumentar (+)
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            background: gap_plus.has-hover ? #30363d : #21262d;
                            border-width: 1px;
                            border-color: #30363d;
                            gap_plus := TouchArea {
                                clicked => {
                                    if (root.gap-val < 32) {
                                        root.gap-val = root.gap-val + 1;
                                        root.gap-changed(root.gap-val);
                                    }
                                }
                            }
                            Text {
                                text: "+";
                                color: #c9d1d9;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            ActionButton {
                text: "💾 Salvar e Aplicar";
                base-color: #1f6feb; // Azul
                clicked => { root.save-and-apply(); }
            }
        }
    }
}
